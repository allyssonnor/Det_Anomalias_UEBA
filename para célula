from pathlib import Path

DATA_DIR = Path("/content/Det_Anomalias_UEBA/data")
links = [
    (DATA_DIR / "synthetic", DATA_DIR / "output_thesis_marathon" / "synthetic"),
    (DATA_DIR / "synthetic2", DATA_DIR / "output_thesis_marathon" / "synthetic2"),
]
for link, target in links:
    if link.is_symlink():
        link.unlink()
    elif link.is_dir():
        continue
    elif link.exists():
        link.unlink()
    link.symlink_to(target, target_is_directory=True)

required_paths = [
    DATA_DIR / "output_thesis_marathon" / "synthetic" / "train",
    DATA_DIR / "output_thesis_marathon" / "synthetic" / "val",
    DATA_DIR / "output_thesis_marathon" / "synthetic" / "test",
    DATA_DIR / "synthetic2" / "test_bruteforce" / "test_bruteforce.jsonl",
]
missing = [str(path) for path in required_paths if not path.exists()]
if missing:
    raise FileNotFoundError("Arquivos/diretórios do pacote de dados ausentes:\n" + "\n".join(missing))

# Treina uma execução demonstrativa (seed 42) e avalia o ataque isolado.
!python -u scripts/detectar.py --exp_config config/detectar_especialista.yaml

