# CÉLULA 3 — confere a cobertura e gera os gráficos da execução
from pathlib import Path
import pandas as pd
from scripts.plotar import generate_demo_plots

RESULT_ROOT = Path("results/demo_banca/full")
arquivos_resultado = sorted(RESULT_ROOT.glob("run_seed*/master_results_table.csv"))
if len(arquivos_resultado) != 10:
    raise RuntimeError(
        f"Esperava resultados para 10 sementes; encontrei {len(arquivos_resultado)} arquivos."
    )

resultados = pd.concat(
    [pd.read_csv(path) for path in arquivos_resultado],
    ignore_index=True,
)
if len(resultados) != 80:
    raise RuntimeError(
        f"Esperava 80 execuções concluídas; encontrei {len(resultados)}. "
        "Verifique as mensagens de erro da célula de treinamento."
    )

chaves_execucao = [
    "seed",
    "dataset",
    "model_preset",
    "training.threshold_mode",
    "model.sequence_length",
]
if resultados.duplicated(chaves_execucao).any():
    raise RuntimeError("Há execuções duplicadas no CSV de resultados da demo.")
if resultados["seed"].nunique() != 10:
    raise RuntimeError("A tabela não contém as dez sementes configuradas.")

generate_demo_plots(
    root=str(RESULT_ROOT),
    output_dir="results/demo_banca",
)

