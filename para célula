from pathlib import Path
import json

DATASET = Path("seed_1_cut.txt")
if not DATASET.is_file() or DATASET.stat().st_size == 0:
    raise FileNotFoundError(f"Dataset reduzido não encontrado ou vazio: {DATASET}")

with DATASET.open("r", encoding="utf-8") as arquivo:
    primeira_linha = next((linha.strip() for linha in arquivo if linha.strip()), "")
if not primeira_linha.startswith("{"):
    raise ValueError(
        f"{DATASET} não parece estar em formato JSONL (cada linha deve ser um objeto JSON)."
    )
json.loads(primeira_linha)
print(f"Dataset da demo: {DATASET} ({DATASET.stat().st_size / 1024**2:.1f} MiB)")

# CÉLULA 2 — preparação prévia: treina uma vez e salva os oito modelos
# Uma semente (42), mantendo o protocolo da tese:
# 2 partições × 2 modelos × 2 modos de limiar = 8 execuções.
# Esta etapa pode levar tempo; não a execute durante a apresentação.
!python -u scripts/detectar.py --exp_config config/demo_banca.yaml

from pathlib import Path
import pandas as pd

RUN_ROOT = Path("results/demo_banca/full/run_seed42")
CSV_TREINO = RUN_ROOT / "master_results_table.csv"
if not CSV_TREINO.is_file():
    raise FileNotFoundError(f"Resultados do treinamento não encontrados: {CSV_TREINO}")

resultados_treino = pd.read_csv(CSV_TREINO)
if len(resultados_treino) != 8:
    raise RuntimeError(
        f"Esperava oito execuções de treino; encontrei {len(resultados_treino)}. "
        "Confira os erros da célula anterior."
    )

artefatos = list(RUN_ROOT.glob("*/trainer_meta.pkl"))
if len(artefatos) != 8:
    raise RuntimeError(
        f"Esperava oito modelos salvos; encontrei {len(artefatos)}. "
        "Confira se todos os treinos terminaram."
    )
print("Preparação concluída. Os oito modelos e os dados de teste pré-processados estão no runtime.")

# CÉLULA 3 — demonstração ao vivo: inferência e gráficos, sem treinamento
from pathlib import Path
from scripts.inferir import rodar_inferencia
from scripts.plotar import generate_demo_plots
from IPython.display import Image, display, HTML
import pandas as pd

SEED = 42
RUN_ROOT = Path("results/demo_banca/full/run_seed42")
CACHE_ROOT = Path("data/GLOBAL_CACHE_DETECTOR_demo_banca")
DATASETS = [
    ("Synthetic_Chronological_Demo", "chronological"),
    ("Synthetic_Random_Demo", "random"),
]
MODELS = [
    ("RandomForest", True),
    ("MLP_Single", False),
]
THRESHOLDS = ["global", "per_user"]
RELATORIOS = []

for dataset_name, split in DATASETS:
    for model_name, supervised in MODELS:
        cache_dir = (
            CACHE_ROOT
            / dataset_name
            / f"seed_{SEED}"
            / split
            / f"seq_20_sup_{supervised}"
        )
        for threshold_mode in THRESHOLDS:
            model_dir = RUN_ROOT / (
                f"{dataset_name}_{model_name}_{threshold_mode}_20"
            )
            if not (model_dir / "trainer_meta.pkl").is_file():
                raise FileNotFoundError(
                    f"Modelo não encontrado: {model_dir}. Execute a célula 2 antes."
                )
            relatorio = rodar_inferencia(
                "config/demo_banca.yaml",
                model_run_dir=str(model_dir),
                cached_test_dir=str(cache_dir),
            )
            RELATORIOS.append(relatorio)

if len(RELATORIOS) != 8:
    raise RuntimeError(f"Esperava oito inferências; foram concluídas {len(RELATORIOS)}.")

generate_demo_plots(
    root=str(RUN_ROOT),
    output_dir="results/demo_banca/inferencia",
    source="inference",
)

display(HTML("<h3>Matrizes de confusão da inferência (seed 42)</h3>"))
display(Image(filename="results/demo_banca/inferencia/matrizes_confusao_demo.png", width=1200))
display(HTML("<h3>Métricas por partição, modelo e limiar</h3>"))
display(Image(filename="results/demo_banca/inferencia/metricas_demo.png", width=1200))
