from pathlib import Path
import json

DATASET = Path("seed_1_cut.txt")
if not DATASET.is_file() or DATASET.stat().st_size == 0:
    raise FileNotFoundError(f"Dataset reduzido não encontrado ou vazio: {DATASET}")

with DATASET.open("r", encoding="utf-8") as arquivo:
    primeira_linha = next((linha.strip() for linha in arquivo if linha.strip()), "")
if primeira_linha.startswith("{"):
    json.loads(primeira_linha)
    formato = "JSONL"
else:
    # DatasetAdapter também aceita CSV; valida somente a leitura do cabeçalho.
    import pandas as pd
    amostra = pd.read_csv(DATASET, nrows=1)
    if amostra.empty:
        raise ValueError(f"Dataset sem registros: {DATASET}")
    formato = "CSV"
print(
    f"Dataset generalista: {DATASET} ({DATASET.stat().st_size / 1024**2:.1f} MiB; "
    f"formato detectado: {formato})"
)

# Dataset especialista de brute force conforme YAML 05 da tese.
BRUTEFORCE_DATASET = Path("data/test_bruteforce_42.jsonl")
if not BRUTEFORCE_DATASET.is_file() or BRUTEFORCE_DATASET.stat().st_size == 0:
    raise FileNotFoundError(
        "Coloque o dataset de brute force da tese em "
        f"{BRUTEFORCE_DATASET} antes de executar a demo."
    )
with BRUTEFORCE_DATASET.open("r", encoding="utf-8") as arquivo:
    primeira_linha_bf = next((linha.strip() for linha in arquivo if linha.strip()), "")
if not primeira_linha_bf:
    raise ValueError(f"Dataset de brute force sem registros: {BRUTEFORCE_DATASET}")
try:
    json.loads(primeira_linha_bf)
except json.JSONDecodeError as erro:
    raise ValueError(
        f"O dataset de brute force precisa estar em JSONL válido: {BRUTEFORCE_DATASET}"
    ) from erro
print(
    f"Dataset de brute force: {BRUTEFORCE_DATASET} "
    f"({BRUTEFORCE_DATASET.stat().st_size / 1024**2:.1f} MiB; JSONL)"
)

# CÉLULA 2 — preparação prévia: treina uma vez e salva os dezesseis modelos
# Uma semente (42), mantendo os protocolos YAML 02 e YAML 05 da tese:
# 4 conjuntos (generalista/brute force × cronológico/aleatório) × 2 modelos
# (RandomForest/MLP_Single) × 2 modos de limiar = 16 execuções.
# Esta etapa pode levar tempo; não a execute durante a apresentação.
!python -u scripts/detectar.py --exp_config config/demo_banca.yaml

from pathlib import Path
import pandas as pd

RUN_ROOT = Path("results/demo_banca_v2/full/run_seed42")
CSV_TREINO = RUN_ROOT / "master_results_table.csv"
if not CSV_TREINO.is_file():
    raise FileNotFoundError(f"Resultados do treinamento não encontrados: {CSV_TREINO}")

resultados_treino = pd.read_csv(CSV_TREINO)
if len(resultados_treino) != 16:
    raise RuntimeError(
        f"Esperava dezesseis execuções de treino; encontrei {len(resultados_treino)}. "
        "Confira os erros da célula anterior."
    )

artefatos = list(RUN_ROOT.glob("*/trainer_meta.pkl"))
if len(artefatos) != 16:
    raise RuntimeError(
        f"Esperava dezesseis modelos salvos; encontrei {len(artefatos)}. "
        "Confira se todos os treinos terminaram."
    )
print(
    "Preparação concluída. Os 16 modelos estão salvos; a célula 3 processará "
    "test_prev_5pct.jsonl como dataset de destino."
)

# CÉLULA 3 — inferência ao vivo no dataset de destino, sem treinamento
from pathlib import Path
import subprocess
import sys
import pandas as pd
from scripts.plotar import generate_batch_inference_plots
from IPython.display import Image, display, HTML

RUN_ROOT = Path("results/demo_banca_v2/full/run_seed42")
TARGET_DATASET = Path("data/test_prev_5pct.jsonl")
OUTPUT_DIR = Path("results/demo_banca_v2/inferencia_test_prev_5pct")
CSV_RESULTADOS = OUTPUT_DIR / "batch_inferencia_test_prev_5pct.csv"

# O seed_1_cut.txt (e o dataset de brute force) foi usado na célula 2 para treino.
# Aqui, todos os modelos treinados são avaliados no mesmo dataset externo de destino.
if not TARGET_DATASET.is_file() or TARGET_DATASET.stat().st_size == 0:
    raise FileNotFoundError(
        f"Dataset de inferência ausente ou vazio: {TARGET_DATASET}. "
        "Confirme que data/test_prev_5pct.jsonl está no Git."
    )
with TARGET_DATASET.open("r", encoding="utf-8") as arquivo:
    primeira_linha = next((linha.strip() for linha in arquivo if linha.strip()), "")
if not primeira_linha:
    raise ValueError(f"Dataset de inferência sem registros: {TARGET_DATASET}")
try:
    import json
    json.loads(primeira_linha)
except json.JSONDecodeError as erro:
    raise ValueError(f"Dataset precisa estar em JSONL válido: {TARGET_DATASET}") from erro

if not RUN_ROOT.is_dir():
    raise FileNotFoundError(f"Modelos da demo não encontrados: {RUN_ROOT}. Execute a célula 2.")
model_artifacts = list(RUN_ROOT.glob("*/trainer_meta.pkl"))
if len(model_artifacts) != 16:
    raise RuntimeError(
        f"Esperava 16 modelos (generalista/brute force × 2 partições × 2 modelos × "
        f"2 limiares); encontrei {len(model_artifacts)} em {RUN_ROOT}."
    )
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

subprocess.run(
    [
        sys.executable,
        "-u",
        "scripts/batch_inferir.py",
        "--root",
        str(RUN_ROOT),
        "--dataset",
        str(TARGET_DATASET),
        "--output",
        str(CSV_RESULTADOS),
    ],
    check=True,
)

resultados_batch = pd.read_csv(CSV_RESULTADOS)
fontes_batch = resultados_batch["source_dir"].nunique()
dataset_batch = set(resultados_batch["inference_dataset"].dropna().astype(str))
percentis_batch = set(pd.to_numeric(resultados_batch["percentile"], errors="coerce").dropna())
if fontes_batch != 16 or len(resultados_batch) != 160:
    raise RuntimeError(
        f"Inferência incompleta: esperava 160 resultados (16 modelos × 10 percentis), "
        f"recebi {len(resultados_batch)} linhas de {fontes_batch} modelos."
    )
if dataset_batch != {TARGET_DATASET.name} or percentis_batch != set(range(90, 100)):
    raise RuntimeError(
        "A saída não corresponde exatamente a test_prev_5pct.jsonl nos percentis 90–99."
    )

figuras = generate_batch_inference_plots(
    csv_path=CSV_RESULTADOS,
    output_dir=OUTPUT_DIR,
    confusion_percentile=95,
)

display(HTML(
    "<h3>Matrizes de confusão em test_prev_5pct.jsonl (percentil 95)</h3>"
))
display(Image(filename=str(figuras["confusion"]), width=1500))
display(HTML("<h3>Precisão, recall e F1 ao variar o percentil do limiar</h3>"))
display(Image(filename=str(figuras["curves"]), width=1500))
display(HTML("<h3>PR-AUC, Lift_PR e ROC-AUC por modelo</h3>"))
display(Image(filename=str(figuras["ranking"]), width=1500))
display(pd.read_csv(figuras["summary"]))
