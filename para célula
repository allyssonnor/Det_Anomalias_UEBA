from pathlib import Path
import json

DATASET = Path("seed_1_cut.txt")
if not DATASET.is_file() or DATASET.stat().st_size == 0:
    raise FileNotFoundError(f"Dataset reduzido não encontrado ou vazio: {DATASET}")

with DATASET.open("r", encoding="utf-8") as arquivo:
    primeira_linha = next((linha.strip() for linha in arquivo if linha.strip()), "")
if primeira_linha.startswith("{"):
    json.loads(primeira_linha)
    formato = "JSONL"
else:
    # DatasetAdapter também aceita CSV; valida somente a leitura do cabeçalho.
    import pandas as pd
    amostra = pd.read_csv(DATASET, nrows=1)
    if amostra.empty:
        raise ValueError(f"Dataset sem registros: {DATASET}")
    formato = "CSV"
print(
    f"Dataset generalista: {DATASET} ({DATASET.stat().st_size / 1024**2:.1f} MiB; "
    f"formato detectado: {formato})"
)

# Dataset especialista de brute force conforme YAML 05 da tese.
BRUTEFORCE_DATASET = Path("data/test_bruteforce_42.jsonl")
if not BRUTEFORCE_DATASET.is_file() or BRUTEFORCE_DATASET.stat().st_size == 0:
    raise FileNotFoundError(
        "Coloque o dataset de brute force da tese em "
        f"{BRUTEFORCE_DATASET} antes de executar a demo."
    )
with BRUTEFORCE_DATASET.open("r", encoding="utf-8") as arquivo:
    primeira_linha_bf = next((linha.strip() for linha in arquivo if linha.strip()), "")
if not primeira_linha_bf:
    raise ValueError(f"Dataset de brute force sem registros: {BRUTEFORCE_DATASET}")
try:
    json.loads(primeira_linha_bf)
except json.JSONDecodeError as erro:
    raise ValueError(
        f"O dataset de brute force precisa estar em JSONL válido: {BRUTEFORCE_DATASET}"
    ) from erro
print(
    f"Dataset de brute force: {BRUTEFORCE_DATASET} "
    f"({BRUTEFORCE_DATASET.stat().st_size / 1024**2:.1f} MiB; JSONL)"
)

# CÉLULA 2 — preparação prévia: treina uma vez e salva os dezesseis modelos
# Uma semente (42), mantendo os protocolos YAML 02 e YAML 05 da tese:
# 4 conjuntos (generalista/brute force × cronológico/aleatório) × 2 modelos
# (RandomForest/MLP_Single) × 2 modos de limiar = 16 execuções.
# Esta etapa pode levar tempo; não a execute durante a apresentação.
!python -u scripts/detectar.py --exp_config config/demo_banca.yaml

from pathlib import Path
import pandas as pd

RUN_ROOT = Path("results/demo_banca_v2/full/run_seed42")
CSV_TREINO = RUN_ROOT / "master_results_table.csv"
if not CSV_TREINO.is_file():
    raise FileNotFoundError(f"Resultados do treinamento não encontrados: {CSV_TREINO}")

resultados_treino = pd.read_csv(CSV_TREINO)
if len(resultados_treino) != 16:
    raise RuntimeError(
        f"Esperava dezesseis execuções de treino; encontrei {len(resultados_treino)}. "
        "Confira os erros da célula anterior."
    )

artefatos = list(RUN_ROOT.glob("*/trainer_meta.pkl"))
if len(artefatos) != 16:
    raise RuntimeError(
        f"Esperava dezesseis modelos salvos; encontrei {len(artefatos)}. "
        "Confira se todos os treinos terminaram."
    )
print(
    "Preparação concluída. Os 16 modelos e os dados de teste pré-processados "
    "estão no runtime."
)

# CÉLULA 3 — demonstração ao vivo: inferência e gráficos, sem treinamento
from pathlib import Path
from scripts.inferir import rodar_inferencia
from scripts.plotar import generate_demo_plots
from IPython.display import Image, display, HTML
import pandas as pd

SEED = 42
RUN_ROOT = Path("results/demo_banca_v2/full/run_seed42")
CACHE_ROOT = Path("data/GLOBAL_CACHE_DETECTOR_demo_banca_v2")
DATASETS = [
    # YAML 02: modelos generalistas no dataset reduzido versionado no Git.
    ("Synthetic_Chronological_Demo", "chronological"),
    ("Synthetic_Random_Demo", "random"),
    # YAML 05: cenário de brute force no dataset fornecido para a banca.
    ("Synthetic_Chronological_Bruteforce", "chronological"),
    ("Synthetic_Random_Bruteforce", "random"),
]
MODELS = [
    ("RandomForest", True),
    ("MLP_Single", False),
]
THRESHOLDS = ["global", "per_user"]
RELATORIOS = []

for dataset_name, split in DATASETS:
    for model_name, supervised in MODELS:
        cache_dir = (
            CACHE_ROOT
            / dataset_name
            / f"seed_{SEED}"
            / split
            / f"seq_20_sup_{supervised}"
        )
        for threshold_mode in THRESHOLDS:
            model_dir = RUN_ROOT / (
                f"{dataset_name}_{model_name}_{threshold_mode}_20"
            )
            if not (model_dir / "trainer_meta.pkl").is_file():
                raise FileNotFoundError(
                    f"Modelo não encontrado: {model_dir}. Execute a célula 2 antes."
                )
            relatorio = rodar_inferencia(
                "config/demo_banca.yaml",
                model_run_dir=str(model_dir),
                cached_test_dir=str(cache_dir),
            )
            RELATORIOS.append(relatorio)

if len(RELATORIOS) != 16:
    raise RuntimeError(
        f"Esperava dezesseis inferências; foram concluídas {len(RELATORIOS)}."
    )

generate_demo_plots(
    root=str(RUN_ROOT),
    output_dir="results/demo_banca_v2/inferencia",
    source="inference",
)

display(HTML("<h3>Matrizes de confusão: generalistas e brute force (seed 42)</h3>"))
display(Image(filename="results/demo_banca_v2/inferencia/matrizes_confusao_demo.png", width=1600))
display(HTML("<h3>Métricas por cenário, partição, modelo e limiar</h3>"))
display(Image(filename="results/demo_banca_v2/inferencia/metricas_demo.png", width=1600))
