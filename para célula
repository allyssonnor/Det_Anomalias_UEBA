from pathlib import Path
import json

DATASET = Path("seed_1_cut.txt")
if not DATASET.is_file() or DATASET.stat().st_size == 0:
    raise FileNotFoundError(f"Dataset reduzido não encontrado ou vazio: {DATASET}")

with DATASET.open("r", encoding="utf-8") as arquivo:
    primeira_linha = next((linha.strip() for linha in arquivo if linha.strip()), "")
if not primeira_linha.startswith("{"):
    raise ValueError(
        f"{DATASET} não parece estar em formato JSONL (cada linha deve ser um objeto JSON)."
    )
json.loads(primeira_linha)
print(f"Dataset da demo: {DATASET} ({DATASET.stat().st_size / 1024**2:.1f} MiB)")

